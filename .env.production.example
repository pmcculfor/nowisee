# Production environment for https://nowisee.app
#
# Node does not load .env files. systemd should inject this with:
#   EnvironmentFile=/etc/nowisee/nowisee.env
# Copy this file there (not into git), fill the secrets, then:
#   sudo mkdir -p /etc/nowisee
#   sudo chown root:nowisee /etc/nowisee /etc/nowisee/nowisee.env
#   sudo chmod 750 /etc/nowisee
#   sudo chmod 640 /etc/nowisee/nowisee.env
#
# Local Vite (`npm run dev`) reads `.env` from the repo root instead. See `.env.example`.

NODE_ENV=production
PORT=3000
NOWISEE_ORIGIN=https://nowisee.app
NOWISEE_DB=/var/www/nowisee/data/nowisee.db

# 32-byte AES key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NOWISEE_LOCKBOX_KEY=

NOWISEE_OAUTH_GMAIL_CLIENT_ID=
NOWISEE_OAUTH_GMAIL_CLIENT_SECRET=

# Sign-in codes. Production origin is not localhost, so console is refused.
NOWISEE_MAIL_DRIVER=resend
NOWISEE_MAIL_FROM="Now I See <login@nowisee.app>"
NOWISEE_RESEND_API_KEY=
# Separate 32-byte base64 pepper; do not reuse NOWISEE_LOCKBOX_KEY.
NOWISEE_OTP_PEPPER=

# Leave unset when Caddy/nginx terminates TLS and proxies to PORT.
# NOWISEE_TLS_CERT=
# NOWISEE_TLS_KEY=
