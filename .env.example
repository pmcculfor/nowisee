# Environment

Copy to `.env` for local Gmail OAuth. Tests leave lockbox/OAuth grants empty and need none of these.

# Public origin for CSRF Origin checks and the OAuth redirect URI ({origin}/oauth/callback).
# Required for npm start / npm run dev when Gmail lockbox+OAuth are granted.
NOWISEE_ORIGIN=http://localhost:5173

# Host identity SQLite (default data/nowisee.db).
# NOWISEE_DB=data/nowisee.db

# 32-byte AES key, base64. Required when lockbox or OAuth apps are granted.
NOWISEE_LOCKBOX_KEY=

# Optional key id (default v1).
# NOWISEE_LOCKBOX_KEY_ID=v1

# Gmail OAuth client (Google Cloud Web application). Not stored in the lockbox.
NOWISEE_OAUTH_GMAIL_CLIENT_ID=
NOWISEE_OAUTH_GMAIL_CLIENT_SECRET=

# Listen port for npm start (default 3000).
# PORT=3000

# Optional TLS for npm start.
# NOWISEE_TLS_CERT=
# NOWISEE_TLS_KEY=
