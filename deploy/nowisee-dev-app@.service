[Unit]
Description=Nowisee app (%i, dev)
After=network.target nowisee-dev.service
PartOf=nowisee-dev.target

[Service]
Type=simple
User=nowisee-%i
Group=nowisee
WorkingDirectory=/var/www/nowisee-dev
EnvironmentFile=/etc/nowisee/apps-dev/%i.env
ExecStart=/usr/bin/node --experimental-strip-types src/apps/%i/main.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=nowisee-dev.target
