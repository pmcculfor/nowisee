# Copied to /etc/nowisee/apps/<id>.env (mode 640, root:nowisee-<id>).
# Staging twin: /etc/nowisee/apps-dev/<id>.env with 3210+ listen ports.
# The host process never injects these. Apps do not receive lockbox, OTP, or mail secrets.

NOWISEE_LISTEN=127.0.0.1:3114
NOWISEE_APP_DB=/var/www/nowisee/data/apps/notes.db
NOWISEE_HOST_CAPABILITY_URL=http://127.0.0.1:3020
NOWISEE_HOST_SIGNING_PUB=
NOWISEE_ROOT_APP_ID=home
