# Copied to /etc/nowisee/<id>/<id>.env (mode 640, root:nowisee-<id>).
# Staging twin: /etc/nowisee-dev/<id>/<id>.env with 3210+ listen ports
# and NOWISEE_APP_DB under /var/lib/nowisee-dev/<id>/.
# The host process never injects these. Apps do not receive lockbox, OTP,
# OAuth client secrets, or mail secrets.

NOWISEE_LISTEN=127.0.0.1:3114
NOWISEE_APP_DB=/var/lib/nowisee/notes/notes.db
NOWISEE_HOST_CAPABILITY_URL=http://127.0.0.1:3020
NOWISEE_HOST_SIGNING_PUB=
NOWISEE_ROOT_APP_ID=home
