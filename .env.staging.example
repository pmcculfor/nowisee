# Staging environment for https://dev.nowisee.app
#
# Same shape as `.env.production.example`. A second process on the same
# droplet: different checkout, port, origin, SQLite files, secrets, and Unix users.
# Do not copy `/etc/nowisee/host/nowisee.env` here.
#
# Node does not load .env files. systemd injects this with:
#   EnvironmentFile=/etc/nowisee-dev/host/nowisee.env
# Copy this file there (not into git), fill the secrets, then:
#   sudo mkdir -p /etc/nowisee-dev/host
#   sudo chown root:nowisee-dev-host /etc/nowisee-dev/host /etc/nowisee-dev/host/nowisee.env
#   sudo chmod 750 /etc/nowisee-dev/host
#   sudo chmod 640 /etc/nowisee-dev/host/nowisee.env
#
# Nowisee runs only on a server. There are no local-machine defaults: every
# value that is not commented out below is required, and a missing one stops
# the boot.

NODE_ENV=production
PORT=3001
NOWISEE_ORIGIN=https://dev.nowisee.app
NOWISEE_DB=/var/lib/nowisee-dev/host/nowisee.db

NOWISEE_CAPABILITY_LISTEN=127.0.0.1:3021
# Separate Ed25519 key from production. PKCS8 DER, base64.
NOWISEE_HOST_SIGNING_KEY=

# New 32-byte AES key, base64. Do not reuse production NOWISEE_LOCKBOX_KEY.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NOWISEE_LOCKBOX_KEY=
# Names the key above. Required whenever NOWISEE_LOCKBOX_KEY is set.
NOWISEE_LOCKBOX_KEY_ID=v1

NOWISEE_OAUTH_GMAIL_CLIENT_ID=
NOWISEE_OAUTH_GMAIL_CLIENT_SECRET=

# Sign-in codes. Resend is the only mail driver.
NOWISEE_MAIL_FROM="Now I See Dev <login@nowisee.app>"
NOWISEE_RESEND_API_KEY=
# New 32-byte base64 pepper; do not reuse production NOWISEE_OTP_PEPPER or NOWISEE_LOCKBOX_KEY.
NOWISEE_OTP_PEPPER=

# Comma-separated. Empty or unset disables /admin.
NOWISEE_ADMIN_EMAILS=

# Leave unset when Caddy terminates TLS and proxies to PORT.
# NOWISEE_TLS_CERT=
# NOWISEE_TLS_KEY=
