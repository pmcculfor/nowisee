[Unit]
Description=Nowisee host (dev)
After=network.target
PartOf=nowisee-dev.target

[Service]
Type=simple
User=nowisee-host
Group=nowisee
WorkingDirectory=/var/www/nowisee-dev
EnvironmentFile=/etc/nowisee/nowisee-dev.env
ExecStart=/usr/bin/node --experimental-strip-types server/index.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=nowisee-dev.target
