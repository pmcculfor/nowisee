# Production environment for https://nowisee.app
# Staging twin: `.env.staging.example` → `/etc/nowisee-dev/host/nowisee.env`.
#
# Node does not load .env files. systemd injects this with:
#   EnvironmentFile=/etc/nowisee/host/nowisee.env
# Copy this file there (not into git), fill the secrets, then:
#   sudo mkdir -p /etc/nowisee/host
#   sudo chown root:nowisee-host /etc/nowisee/host /etc/nowisee/host/nowisee.env
#   sudo chmod 750 /etc/nowisee/host
#   sudo chmod 640 /etc/nowisee/host/nowisee.env
#
# Nowisee runs only on a server. There are no local-machine defaults: every
# value that is not commented out below is required, and a missing one stops
# the boot.

NODE_ENV=production
PORT=3000
NOWISEE_ORIGIN=https://nowisee.app
NOWISEE_DB=/var/lib/nowisee/host/nowisee.db

# Loopback capability server. Not in Caddy. Apps POST here with a per-dispatch ticket.
NOWISEE_CAPABILITY_LISTEN=127.0.0.1:3020
# Ed25519 PKCS8 DER, base64. Generate: node -e "const {generateKeyPairSync}=require('crypto'); const k=generateKeyPairSync('ed25519'); console.log(k.privateKey.export({type:'pkcs8',format:'der'}).toString('base64')); console.log(k.publicKey.export({type:'spki',format:'der'}).toString('base64'))"
NOWISEE_HOST_SIGNING_KEY=

# 32-byte AES key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NOWISEE_LOCKBOX_KEY=
# Names the key above. Required whenever NOWISEE_LOCKBOX_KEY is set.
NOWISEE_LOCKBOX_KEY_ID=v1

NOWISEE_OAUTH_GMAIL_CLIENT_ID=
NOWISEE_OAUTH_GMAIL_CLIENT_SECRET=

# Sign-in codes. Resend is the only mail driver.
NOWISEE_MAIL_FROM="Now I See <login@nowisee.app>"
NOWISEE_RESEND_API_KEY=
# Separate 32-byte base64 pepper; do not reuse NOWISEE_LOCKBOX_KEY.
NOWISEE_OTP_PEPPER=

# Comma-separated. Empty or unset disables /admin.
NOWISEE_ADMIN_EMAILS=

# Leave unset when Caddy/nginx terminates TLS and proxies to PORT.
# NOWISEE_TLS_CERT=
# NOWISEE_TLS_KEY=

# Apple Team ID (Xcode → Signing & Capabilities). Required to serve
# /.well-known/apple-app-site-association for native Gmail Connect.
# NOWISEE_IOS_TEAM_ID=
