[Unit]
Description=Nowisee host
After=network.target
PartOf=nowisee.target

[Service]
Type=simple
User=nowisee-host
Group=nowisee
WorkingDirectory=/var/www/nowisee
EnvironmentFile=/etc/nowisee/nowisee.env
ExecStart=/usr/bin/node --experimental-strip-types server/index.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=nowisee.target
