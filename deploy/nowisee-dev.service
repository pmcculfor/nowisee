[Unit]
Description=Nowisee host (dev)
After=network.target
PartOf=nowisee-dev.target

[Service]
Type=simple
User=nowisee-dev-host
Group=nowisee-dev
WorkingDirectory=/var/www/nowisee-dev
EnvironmentFile=/etc/nowisee-dev/host/nowisee.env
ExecStart=/usr/bin/node --experimental-strip-types src/host/index.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=nowisee-dev.target
